# Database Configuration
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=pdam_billing

# OpenRouter API Key (Kecerdasan Buatan — untuk Embedding)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Groq API Key (Model LLM utama)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=

# ─────────────────────────────────────────────
# CORS — Domain yang diizinkan memanggil API ini
# ─────────────────────────────────────────────
ALLOWED_ORIGIN_1=http://localhost:8000
ALLOWED_ORIGIN_2=
ALLOWED_ORIGIN_3=

# ─────────────────────────────────────────────
# Admin API Key — Wajib diisi untuk melindungi endpoint /api/faqs/sync
# Gunakan string acak yang kuat, contoh: openssl rand -hex 32
# ─────────────────────────────────────────────
ADMIN_API_KEY=
